    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "ioredis": "^5.9.2",
    "jose": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^15.1.0",
    "multer": "^1.4.5-lts.1",
