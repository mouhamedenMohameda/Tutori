{
  "name": "brighttutor-backend",
  "version": "1.0.0",
  "description": "BrightTutor API - Node + Express backend",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --transpile-only -r tsconfig-paths/register src/index.ts",
    "dev:watch": "nodemon --exec ts-node --transpile-only -r tsconfig-paths/register src/index.ts",
    "dev:fullstack": "bash scripts/run-fullstack.sh",
    "build": "node build.js",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --runInBand --watch",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.3",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "ioredis": "^5.9.2",
    "jose": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^15.1.0",
    "multer": "^2.0.0",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.18.0",
    "typeorm": "^0.3.28",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.6",
    "esbuild": "^0.27.2",
    "esbuild-plugin-alias-path": "^2.0.2",
    "esbuild-register": "^3.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "glob": "^10.4.2"
  }
}
