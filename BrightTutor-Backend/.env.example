# BrightTutor Backend - same env as BrightTutor-AI-Platform
# Copy to .env.local for the app (same as AI Platform). .env.local takes precedence over .env.

# Database (same RDS as AI Platform; pooling params added automatically)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"
# Optional: DB_CONNECTION_LIMIT=15

# Auth
JWT_SECRET="your-jwt-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
CRON_SECRET="your-cron-secret"

# App
NODE_ENV="development"
PORT="4000"
APP_URL="http://localhost:4000"
DOMAIN="localhost:4000"

# AI / APIs (same keys as AI Platform)
OPENAI_API_KEY="sk-your-openai-key"
GEMINI_API_KEY="your_gemini_key"
GOOGLE_VISION_API_KEY="your-google-vision-key"

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760
PLATFORM_ADMIN_SECRET="your-platform-admin-secret"

# Optional
REDIS_URL="redis://localhost:6379"
