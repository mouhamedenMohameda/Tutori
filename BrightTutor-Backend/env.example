# BrightTutor Backend - copy to .env

# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/brighttutor"

# Auth
JWT_SECRET="your-super-secure-jwt-secret-min-32-chars"

# Cron (required for /api/cron/* - use a strong secret in production)
CRON_SECRET="your-cron-secret-change-in-production"

# Startup check (optional - allows /api/startup without platform-admin token in dev)
STARTUP_SECRET=""

# Admin / Platform
ADMIN_SECRET=""
PLATFORM_ADMIN_SECRET=""

# AI
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="..."

# Optional: Google Vision (OCR)
GOOGLE_VISION_API_KEY=""

# Redis (rate limiting, cache - optional, falls back to memory)
REDIS_URL="redis://localhost:6379"

# Optional: AI / streaming
ENABLE_STREAMING=false
AI_RESPONSE_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
AI_CONCEPT_EXTRACTION=false

# Optional: Analytics
ANALYTICS_EVENTS_FILE=""

# Optional: CORS / domain
ALLOWED_ORIGINS=""
NEXT_PUBLIC_DOMAIN=""
BUILD_ID=""
